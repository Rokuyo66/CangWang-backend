 "buttons": {
  "_說明": "按鈕四型與兩段開關。linked＝照下面算式從主題色碼推；false 時 custom[主題][元件][零件] 單獨設值。face 的 LIGHTFACE＝淺色主題用亮一階的紙、深色主題用 --paper-2。值是物件 {l,d} 時淺色／深色主題各一條。",
  "linked": true,
  "custom": {},
  "types": [
   {
    "k": "primary",
    "n": "主按鈕",
