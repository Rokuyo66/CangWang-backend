@admin_only
async def cmd_ideas(update, ctx):
    return await reply(update, f"自由出題已停用，三種稿都有固定缺口：按 {B_IDEAS}。")
    args = list(ctx.args)
    n = 5
    if args and args[0].isdigit():
        n = int(args.pop(0))
    await do_ideas(update, ctx, n, " ".join(args))


