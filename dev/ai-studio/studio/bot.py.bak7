BUTTONS = {B_IDEAS: cmd_gaps, B_POOL: cmd_pool, B_TEAM: cmd_team, B_LIST: cmd_list, B_JOBS: cmd_jobs, B_PAUSE: cmd_pause,
           B_RESUME: cmd_resume, B_STOP: cmd_stop}


async def reply_note(update, tid, label, text):
    t, err = add_note(tid, label, text)
    if err:
        return await reply(update, err)
    n = len(t["draft_notes"])
    await update.message.reply_text(
        tag(f"📝 已記下第 {n} 條（{label}）：{text}\n可以繼續補充，好了就送出。"),
        reply_markup=InlineKeyboardMarkup([[
            InlineKeyboardButton(f"📨 送出 {n} 條重寫", callback_data=f"sd:{tid}"),
            InlineKeyboardButton("👀 重看這份", callback_data=f"vw:{tid}")]]))


@admin_only
async def on_text(update, ctx):
    text = update.message.text.strip()
    if text in BUTTONS:
        return await BUTTONS[text](update, ctx)
    if text == B_NEW:
        return await reply(update, f"要寫哪一種、寫誰：按 {B_IDEAS} 點選，或用\n/letter 師妹 100\n/chapter 觀喵 1 （後面可接方向）\n/jianghu 5")
    if text == "/skip" and ctx.chat_data.pop("await_edit", None):
        return await reply(update, "取消，沒有改。")
    wait = ctx.chat_data.pop("await_reason", None)
    if wait and text != "/skip":
        tid, label = wait
        return await reply_note(update, tid, label, text)
    if wait:
        return await reply(update, "取消，沒有記下建議。")
    if text.startswith("/"):
        return
    ed = ctx.chat_data.pop("await_edit", None)
    if ed:
        t, msg = apply_direct(ed[0], ed[1], text)
        return await update.message.reply_text(tag(msg), reply_markup=after_edit_kb(ed[0]) if t else MENU)
    rt = update.message.reply_to_message
    if rt and lookup_msg(rt.message_id):
        tid, label = lookup_msg(rt.message_id)
        if len(text) >= 60:  # 長文多半是改好的版本，先問清楚
            ctx.chat_data["choose"] = (tid, label, text)
            return await update.message.reply_text(
                tag(f"這段（{len(text)} 字）要怎麼用？"),
                reply_markup=InlineKeyboardMarkup([[
                    InlineKeyboardButton("📝 取代原文", callback_data=f"ch:r:{tid}"),
                    InlineKeyboardButton("💬 當成建議", callback_data=f"ch:n:{tid}")]]))
        return await reply_note(update, tid, label, text)
    edit = ctx.chat_data.pop("await_idea", None)
    if edit:
        stage, p = find_task(edit)
        if not p or stage != "ideas":
            return await reply(update, "這題已經不在題庫了。")
        t = read_json(p)
        t["original_brief"], t["brief"] = t["brief"], text
        move_task(t, "queue")
        return await reply(update, f"✏️ 已改好並排入佇列：{text}")
    if ctx.chat_data.pop("await_brief", False):
        return await reply(update, f"題目現在要指定格式：按 {B_IDEAS}，或 /letter /chapter /jianghu。")
    m = re.match(r"^題\s*[:：]\s*(.+)", text, re.S)
    if m:
        return await reply(update, f"題目現在要指定格式：按 {B_IDEAS}，或 /chapter 師妹 1 {m.group(1)}（方向接在後面）。")
    # 其他一律交給本地助理
    ctx.application.bot_data["agent_busy"] = True
    try:
        await ctx.bot.send_chat_action(update.effective_chat.id, "typing")
        hist = ctx.chat_data.setdefault("agent_history", [])
        out, by_model = await agent.chat(ctx.application.bot_data["ollama"], hist, text,
                                         A(ctx).handlers(), list(team.DEFAULT_JOBS), ops.BUTTON_OPS)
    finally:
        ctx.application.bot_data["agent_busy"] = False
    await reply(update, out, sender="agent" if by_model else "duty")


async def on_button(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    q = update.callback_query
    if not is_admin(update):
        await q.answer("未授權")
        return
    act, _, rest = q.data.partition(":")
    if act in ("iw", "ie", "ix"):
        stage, p = find_task(rest)
        if not p or stage != "ideas":
            await q.answer("這題已處理過")
            await q.edit_message_reply_markup(None)
            return
        t = read_json(p)
        if act == "iw" and not t.get("kind"):
            await q.answer("舊格式題目，不能直接寫")
            await q.message.reply_text(tag(f"這題是舊格式。要寫成道緣章：/chapter 師妹 1 {t['brief'][:40]}"))
            return
        if act == "iw":
            move_task(t, "queue")
            await q.answer("排入佇列")
            await q.edit_message_text(f"{who('writer')}\n✅ {t['brief']}\n（已排入佇列）")
        elif act == "ix":
            move_task(t, "rejected")
            await q.answer("已捨棄")
            await q.edit_message_text(f"{who('writer')}\n🗑 <s>{pipeline._e(t['brief'])}</s>", parse_mode="HTML")
        else:
            ctx.chat_data["await_idea"] = t["id"]
            await q.answer()
            await q.message.reply_text(tag(f"✏️ 原題：{t['brief']}\n打你改好的題目（整句），送出就排入佇列："))
        return
    if act == "bk":
        kind, cid, num = rest.split(":")
        res = await A(ctx).add_task(kind, cid, int(num))
        await q.answer("已排入" if res.startswith("已排入") else "沒排入")
        await q.message.reply_text(tag(res), reply_markup=MENU)
        try:
            await q.edit_message_text(tag(gaps_text()), reply_markup=gaps_markup())
        except Exception:
            pass
        return
    if act == "jb":
        key, on = rest.split(":")
        team.set_job(key, on == "1")
        await q.answer("已切換")
        await q.edit_message_text(tag(jobs_text()), reply_markup=jobs_markup())
        return
    if act == "op":
        await q.answer("執行中…")
        res = await ops.run_op(ctx.application, rest)
        await q.message.reply_text(tag(f"{ops.OPS.get(rest, rest)} → {res}"), reply_markup=MENU)
        return
    if act == "nk":  # 每晚詢問：照舊
        await q.answer()
        await q.edit_message_reply_markup(None)
        await q.message.reply_text(tag("好，今晚照目前設定跑。"), reply_markup=MENU)
        return
    if act == "ch":
        mode, _, tid2 = rest.partition(":")
        got = ctx.chat_data.pop("choose", None)
        await q.answer()
        await q.edit_message_reply_markup(None)
        if not got or got[0] != tid2:
            await q.message.reply_text(tag("找不到剛才那段，請再回覆一次。"))
            return
        if mode == "r":
            t2, msg = apply_direct(*got)
            await q.message.reply_text(tag(msg), reply_markup=after_edit_kb(tid2) if t2 else MENU)
        else:
            t2, err = add_note(*got)
            await q.message.reply_text(tag(err or f"💬 已記成建議（共 {len(t2['draft_notes'])} 條），好了按 📨 送出。"),
                                       reply_markup=MENU if err else InlineKeyboardMarkup([[
                                           InlineKeyboardButton(f"📨 送出 {len(t2['draft_notes'])} 條重寫", callback_data=f"sd:{tid2}")]]))
        return
    tid = rest.split(":")[0]
    stage, p = find_task(tid)
    if not p:
        await q.answer("任務不存在")
        return
    t = read_json(p)
    if act == "vw":
        await q.answer()
        await send_view(ctx.bot, q.message.chat_id, t)
        return
    if stage != "pending":
        await q.answer(f"已在 {stage}")
        return
    if act == "ed":
        tid2, _, label = rest.partition(":")
        ctx.chat_data["await_edit"] = (tid2, label or "整篇")
        await q.answer()
        k = kinds.kind_of(t)
        await q.message.reply_text(tag(f"📝 #{tid2}【{label}】貼上你改好的版本，會原樣取代（不經寫手）。\n"
                                       f"{EDIT_HELP.get(k.key if k else '', '')}\n取消傳 /skip"))
        return
    if act == "ro":
        t["review_only"] = True
        t["priority"] = True
        requeue(t)
        await q.answer("已排入")
        await q.message.reply_text(tag(f"🔎 #{tid} 你的版本排到最前面送審（不重寫）。"), reply_markup=MENU)
        return
    if act == "nt":
        tid2, _, label = rest.partition(":")
        ctx.chat_data["await_reason"] = (tid2, label or "整篇")
        await q.answer()
        await q.message.reply_text(tag(f"✏️ #{tid2}【{label}】要怎麼改？直接打字（可提 L 行號）；取消傳 /skip"))
        return
    if act == "sd":
        await q.answer("已送出")
        await q.message.reply_text(tag(submit_notes(tid)), reply_markup=MENU)
        return
    if act == "rw":
        await q.answer("已排入")
        await q.message.reply_text(tag(submit_notes(tid, [])), reply_markup=MENU)
        return
    if act == "ap":
        move_task(t, "approved")
        await q.answer("已通過")
        await q.edit_message_reply_markup(None)
        await q.message.reply_text(tag(f"✅ #{tid} 已通過，等 {who('claude')} 終審。"), reply_markup=MENU)
    elif act == "dr":
        move_task(t, "rejected")
        await q.answer("已捨棄")
        await q.edit_message_reply_markup(None)
    elif act == "rd":
        ctx.chat_data["await_reason"] = (tid, "整篇")
        await q.answer()
        await q.message.reply_text(tag(f"✏️ #{tid} 要怎麼改？直接打字；取消傳 /skip"))


# ---------- 進度卡 ----------
class Card:
    """每份稿一張訊息卡，跑的時候原地更新；第一行標明現在是誰在做。"""

    def __init__(self, app, t):
        self.app, self.t = app, t
        self.msg = None
        self.step, self.done = "準備中", []
        self.started = self.step_at = time.time()
        self.final = None

    def text(self):
        now_t = time.time()
        actor = who("reviewer") if "審稿" in self.step and not self.final else who("writer")
        lines = [actor if not self.final else who("duty"),
                 (self.final or f"▶️ #{self.t['id']}"), f"題目：{self.t['brief']}", *self.done]
        if not self.final:
            lines.append(f"⏳ {self.step}（{mmss(now_t - self.step_at)}）")
        lines.append(f"整份 {mmss(now_t - self.started)}｜佇列還有 {len(list_stage('queue'))} 份")
        return "\n".join(lines)

    async def push(self):
        cid = load_config()["admin_id"]
        try:
            if self.msg is None:
                self.msg = await self.app.bot.send_message(cid, self.text())
            else:
                await self.msg.edit_text(self.text())
        except BadRequest as e:
            if "not modified" not in str(e):
                log.warning("進度卡更新失敗：%s", e)
        except Exception as e:
            log.warning("進度卡更新失敗：%s", e)

    async def progress(self, step, done_line=None):
        if done_line:
            self.done.append(done_line)
        if step:
            self.step, self.step_at = step, time.time()
        save_state(current={"id": self.t["id"], "brief": self.t["brief"], "step": self.step,
                            "step_at": self.step_at, "started": self.started, "done": self.done})
        await self.push()

    async def ticker(self):
        while True:
            await asyncio.sleep(60)
            await self.push()


# ---------- 背景迴圈 ----------
async def idle_ideas(app):
    """閒置自動補缺口：佇列空了就排下一封道緣信（三人輪流），每天最多 9 封。"""
    st = load_state()
    today = now().strftime("%Y-%m-%d")
    count = st.get("idle_ideas_count", 0) if st.get("idle_ideas_date") == today else 0
    if count >= 9 or time.time() - st.get("idle_ideas_at", 0) < 600:
        return False
    save_state(idle_ideas_at=time.time())
    gaps = kinds.KINDS["letter"].backlog()
    if not gaps:
        return False
    m = gaps[count % len(gaps)]
    res = await app.bot_data["actions"].add_task("letter", m["character_id"], m["at"])
    save_state(idle_ideas_date=today, idle_ideas_count=count + 1)
    await notify(app, "佇列空了，依排程補一封道緣信：" + res, sender="duty")
    return res.startswith("已排入")


async def worker(app: Application):
    o: Ollama = app.bot_data["ollama"]
    for p in list_stage("work"):
        move_task(read_json(p), "queue")
    save_state(current=None)
    while True:
        cfg, st = load_config(), load_state()
        items = list_stage("queue")
        if not items:
            if st.get("blocked"):
                save_state(blocked=None)
            if not st["paused"] and team.job_on("idle_ideas"):
                try:
                    if await idle_ideas(app):
                        continue
                except Exception as e:
                    log.warning("自動出題失敗：%s", e)
            await asyncio.sleep(20)
            continue
        reason = await blocked_reason(cfg, st)
        if reason != st.get("blocked"):
            save_state(blocked=reason)
            if reason:
                await notify(app, f"佇列有 {len(items)} 份在等：{reason}")
            elif st.get("blocked"):
                await notify(app, "✅ 阻擋解除，開工。")
        if reason:
            await asyncio.sleep(20)
            continue

        tasks = [read_json(p) for p in items]
        legacy = [x for x in tasks if not kinds.kind_of(x)]
        for x in legacy:  # 舊格式（沒指定 kind）不寫，移出
            x["legacy"] = True
            move_task(x, "rejected")
        if legacy:
            await notify(app, f"佇列裡 {len(legacy)} 份舊格式題目已移到捨棄（沒有指定信／章／卦）。")
            continue
        t = next((x for x in tasks if x.get("priority")), tasks[0])
        t.pop("priority", None)
        move_task(t, "work")
        card = Card(app, t)
        await card.progress("開工")
        tick = asyncio.create_task(card.ticker())
        job = asyncio.create_task(pipeline.process(o, t, card.progress))
        app.bot_data["job"] = job
        try:
            ok = await job
            last = t["rounds"][-1]
            score = last["review"].get("score")
            # 10-26 六六：本地 <90 自己排回去繼續修；≥90 送 Claude 複審；Claude ≥95 才交給六六
            if ok:
                move_task(t, "claude")
                card.final = f"🟢 本地 {score} 分，送 Claude 複審"
                await card.push()
                continue
            stall = cfg.get("format_stall", 4)
            tail = t["rounds"][-stall:]
            stalled = len(tail) >= stall and all(
                any(i.get("hard") and i.get("by") == "程式" for i in r["review"].get("issues", [])) for r in tail)
            if not stalled and len(t["rounds"]) < cfg.get("round_cap", 12):
                move_task(t, "queue")
                card.final = f"🔁 {score} 分，未到 {cfg['pass_score']}，排回佇列繼續修（第 {len(t['rounds'])} 輪）"
                await card.push()
                continue
            t["needs_human"] = True
            move_task(t, "pending")
            card.final = (f"⚠️ 連續 {stall} 輪程式檢查沒過（硬傷修不掉），停下交你判斷" if stalled
                          else f"⚠️ 寫了 {len(t['rounds'])} 輪仍未到 {cfg['pass_score']}，交你判斷")
            await card.push()
            k = kinds.kind_of(t)
            await notify(app, f"{card.final}｜{last['review']['score']}分\n"
                              f"#{t['id']} {k.label(t)}・{k.title(last['script'])}\n"
                              f"{k.summary(last['script'])}",
                         InlineKeyboardMarkup([[InlineKeyboardButton("📖 展開閱讀", callback_data=f"vw:{t['id']}")],
                                               *final_kb(t["id"], 0).inline_keyboard]), sender="reviewer")
        except asyncio.CancelledError:
            if job.cancelled():
                move_task(t, "queue")
                card.final = "⏹ 已中斷，放回佇列"
                await card.push()
            else:
                raise
        except Exception as e:
            t["errors"] = t.get("errors", 0) + 1
            t["last_error"] = f"{e.__class__.__name__}: {e}"
            log.error("%s 失敗：%s\n%s", t["id"], e, traceback.format_exc())
            if t["errors"] >= 3:
                move_task(t, "rejected")
                card.final = "❌ 連續失敗 3 次，已移出"
            else:
                move_task(t, "queue")
                card.final = f"⚠️ 第{t['errors']}次失敗，2 分鐘後重試"
            await card.push()
            await notify(app, f"{card.final}｜#{t['id']}\n原因：{t['last_error'][:300]}")
            if t["errors"] < 3:
                await asyncio.sleep(120)
        finally:
            tick.cancel()
            app.bot_data["job"] = None
            save_state(current=None)


async def nightly_ask(app):
    """每天 ask_time 問一次今晚排程。"""
    while True:
        await asyncio.sleep(30)
        try:
            cfg, st = load_config(), load_state()
            if not team.job_on("nightly_ask"):
                continue
            n = now(cfg)
            today = n.strftime("%Y-%m-%d")
            if n.strftime("%H:%M") >= cfg.get("ask_time", "21:30") and st.get("asked_date") != today:
                save_state(asked_date=today)
                markup = InlineKeyboardMarkup(
                    [[InlineKeyboardButton("👍 照目前設定", callback_data="nk:")]]
                    + [list(r) for r in jobs_markup().inline_keyboard])
                await notify(app, jobs_text(f"🌙 今晚排程確認（佇列 {len(list_stage('queue'))} 份、"
                                            f"待審 {len(list_stage('pending'))} 份）"), markup)
        except Exception as e:
            log.warning("每晚詢問失敗：%s", e)


async def export_loop():
    """每分鐘把稿件輸出成 讀稿/*.md。"""
    from . import export
    while True:
        try:
            export.export_all()
        except Exception as e:
            log.warning("讀稿輸出失敗：%s", e)
        await asyncio.sleep(60)


async def post_init(app: Application):
    cfg = load_config()
    app.bot_data["ollama"] = Ollama(cfg["ollama_url"])
    app.bot_data["actions"] = Actions(app)
    app.bot_data["started_at"] = time.time()
    try:
        await app.bot.set_my_commands([BotCommand(c, d) for c, d in COMMANDS])
    except Exception as e:
        log.warning("註冊指令選單失敗：%s", e)
    for coro in (worker(app), ops.poll(app, notify), nightly_ask(app), export_loop()):
        asyncio.create_task(coro)
    st = load_state()
    await notify(app, "上線。" + (f"寫稿暫停中，按 {B_RESUME} 繼續。" if st["paused"] else "")
                 + f"\n佇列 {len(list_stage('queue'))} 份。直接打字可以跟本地助理說話，/help 看用法。")


def _main():
    cfg = load_config()
    if not cfg["telegram_token"]:
        raise SystemExit("config.json 缺 telegram_token")
    app = Application.builder().token(cfg["telegram_token"]).post_init(post_init).build()
    for name, fn in [("start", cmd_help), ("help", cmd_help), ("team", cmd_team), ("pool", cmd_pool), ("status", cmd_team),
                     ("list", cmd_list), ("jobs", cmd_jobs), ("ops", cmd_ops), ("view", cmd_view),
                     ("redo", cmd_redo), ("ideas", cmd_ideas), ("pause", cmd_pause),
                     ("resume", cmd_resume), ("stop", cmd_stop), ("log", cmd_log),
                     ("reload", cmd_reload), ("gaps", cmd_gaps), ("letter", cmd_letter),
                     ("chapter", cmd_chapter), ("jianghu", cmd_jianghu)]:
        app.add_handler(CommandHandler(name, fn))
    app.add_handler(CommandHandler("skip", on_text))
    app.add_handler(CallbackQueryHandler(on_button))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, on_text))
    log.info("bot 啟動")
    asyncio.set_event_loop(asyncio.new_event_loop())  # Python 3.14 相容
    app.run_polling(drop_pending_updates=True)


def main():
    setup_logging()
    try:
        _main()
    except BaseException:
        log.error("啟動失敗／崩潰：\n%s", traceback.format_exc())
        raise


if __name__ == "__main__":
    main()
