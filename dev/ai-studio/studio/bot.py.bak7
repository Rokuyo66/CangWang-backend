MSGMAP = team.OPS_DIR / "msgmap.json"


def map_msg(mid, tid, label):
    m = read_json(MSGMAP, {}) or {}
    m[str(mid)] = [tid, label]
    if len(m) > 400:
        m = dict(list(m.items())[-400:])
    write_json(MSGMAP, m)


def lookup_msg(mid):
    return (read_json(MSGMAP, {}) or {}).get(str(mid))


def final_kb(tid, n_notes):
    second = (InlineKeyboardButton(f"📨 送出 {n_notes} 條建議重寫", callback_data=f"sd:{tid}") if n_notes
              else InlineKeyboardButton("🔁 不給建議直接重寫", callback_data=f"rw:{tid}"))
    return InlineKeyboardMarkup([
        [InlineKeyboardButton("✅ 通過", callback_data=f"ap:{tid}"),
         InlineKeyboardButton("🗑 捨棄", callback_data=f"dr:{tid}")],
        [InlineKeyboardButton("✏️ 整篇建議", callback_data=f"nt:{tid}:整篇"), second],
        [InlineKeyboardButton("🔎 只送審（不重寫）", callback_data=f"ro:{tid}")]])


async def send_view(bot, chat_id, t):
    """閱讀模式：開頭、每個場景、選項各一則，最後是審稿意見與操作按鈕。"""
    if not t.get("rounds"):
        await bot.send_message(chat_id, tag(f"#{t['id']} 還沒有稿：{t['brief']}"))
        return
    last = t["rounds"][-1]
    editable = t["status"] == "pending"
    hist = "→".join(f"{r['review']['score']}" for r in t["rounds"])
    parts = pipeline.html_parts_kind(last["script"], t)
    head = (f"{who('writer')}\n#{t['id']}｜{len(t['rounds'])}輪（分數 {hist}）\n"
            f"題目：{pipeline._e(t['brief'])}\n\n")
    for i, (label, html) in enumerate(parts):
        text = (head if i == 0 else "") + html
        markup = (InlineKeyboardMarkup([[InlineKeyboardButton("✏️ 建議", callback_data=f"nt:{t['id']}:{label}"[:64]),
                                          InlineKeyboardButton("📝 直接改", callback_data=f"ed:{t['id']}:{label}"[:64])]])
                  if editable else None)
        msg = await bot.send_message(chat_id, text[:4000], parse_mode="HTML", reply_markup=markup)
        map_msg(msg.message_id, t["id"], label)
    notes = t.get("draft_notes", [])
    tail = who("reviewer") + "\n" + pipeline.review_html(last["review"])
    if notes:
        tail += "\n\n📝 <b>你已記下的建議</b>\n" + "\n".join(pipeline._e(x) for x in notes)
    if editable:
        tail += "\n\n<i>想改哪裡：按段落下的 ✏️，或長按任一則「回覆」直接打建議（可提幕N／PN 編號）。</i>"
    msg = await bot.send_message(chat_id, tail[:4000], parse_mode="HTML",
                                 reply_markup=final_kb(t["id"], len(notes)) if editable else None)
    map_msg(msg.message_id, t["id"], "整篇")


EDIT_HELP = {"letter": "直接貼整封信（稱呼到署名）；改記憶就在「記憶」那則按 📝。",
             "chapter": "用「幕N：新內容」逐幕寫，一幕一行起頭；說話者、場景、選項會保留。",
             "jh_outline": "用「欄位名：內容」，欄位名照閱讀模式的粗體標題（例：核心問題：……）。"}


def apply_direct(tid, label, text):
    """製作人親改：原樣套用成新一輪，只跑程式檢查，不經寫手。"""
    import copy
    stage, p = find_task(tid)
    if not p or stage != "pending":
        return None, f"#{tid} 目前在 {stage or '不存在'}，不能直接改。"
    t = read_json(p)
    k = kinds.kind_of(t)
    doc = copy.deepcopy(t["rounds"][-1]["script"])
    try:
        doc = k.apply_edit(doc, label, text)
    except ValueError as e:
        return None, f"沒套用：{e}"
    issues = k.lint(doc, t)
    rv = pipeline.score_review({"issues": issues, "summary": "製作人親改（只跑程式檢查，未送模型審）"})
    t["rounds"].append({"n": len(t["rounds"]) + 1, "at": now().isoformat(timespec="seconds"), "script": doc,
                        "review": rv, "secs": {"write": 0, "review": 0}, "by": "製作人", "edited": label,
                        "models": {}, "human_feedback": []})
    t["needs_human"] = bool(rv["hard_fail"])
    write_json(p, t)
    warn = ("\n⚠️ 程式檢查有意見：\n" + "\n".join(f"・{i['where']}：{i['detail']}" for i in issues[:5])) if issues else "\n程式檢查通過。"
    return t, f"📝 已用你的版本取代【{label}】（第 {len(t['rounds'])} 輪，製作人版）。{warn}"


def after_edit_kb(tid):
    return InlineKeyboardMarkup([
        [InlineKeyboardButton("✅ 通過", callback_data=f"ap:{tid}"),
         InlineKeyboardButton("🔎 送模型審", callback_data=f"ro:{tid}")],
        [InlineKeyboardButton("👀 重看這份", callback_data=f"vw:{tid}")]])


def add_note(tid, label, text):
    stage, p = find_task(tid)
    if not p or stage != "pending":
        return None, f"#{tid} 目前在 {stage or '不存在'}，不能加建議。"
    t = read_json(p)
    t.setdefault("draft_notes", []).append(f"【{label}】{text}")
    write_json(p, t)
    return t, None


def submit_notes(tid, notes=None):
    stage, p = find_task(tid)
    if not p:
        return "找不到這份。"
    t = read_json(p)
    fb = notes if notes is not None else t.get("draft_notes", [])
    t["human_feedback"] = list(fb)
    t["draft_notes"] = []
    t["priority"] = True
    requeue(t)
    return (f"📨 已送出 {len(fb)} 條建議，#{tid} 排到佇列最前面重寫。" if fb
            else f"🔁 #{tid} 已排到佇列最前面重寫。")


@admin_only
async def cmd_view(update, ctx):
    if not ctx.args:
        await reply(update, "用法：/view ID")
        return
    stage, p = find_task(ctx.args[0])
    if not p:
        await reply(update, "找不到。")
        return
    await send_view(ctx.bot, update.effective_chat.id, read_json(p))


@admin_only
async def cmd_redo(update, ctx):
    if not ctx.args:
        await reply(update, "用法：/redo ID 理由")
        return
    await reply(update, await A(ctx).redo_task(ctx.args[0], " ".join(ctx.args[1:])))


async def do_ideas(update, ctx, n, hint):
    st = load_state()
    if st.get("current"):
        await reply(update, f"寫手正在跑 #{st['current']['id']}，出題會排在它後面。", sender="writer")
    await reply(update, f"💡 發想 {n} 題中…", sender="writer")
    t0 = time.time()
    try:
        out = await A(ctx).brainstorm(n, hint)
    except Exception as e:
        await reply(update, f"出題失敗：{e}", sender="writer")
        return
    await reply(update, f"{out}（{mmss(time.time() - t0)}）", sender="writer")
    await send_pool(ctx.bot, update.effective_chat.id, ctx.application.bot_data.get("last_ideas"))


def pool_kb(tid):
    return InlineKeyboardMarkup([[
        InlineKeyboardButton("✅ 寫這題", callback_data=f"iw:{tid}"),
        InlineKeyboardButton("✏️ 改了再寫", callback_data=f"ie:{tid}"),
        InlineKeyboardButton("🗑", callback_data=f"ix:{tid}")]])


async def send_pool(bot, chat_id, ids=None):
    items = [read_json(p) for p in list_stage("ideas")]
    if ids:
        items = [t for t in items if t["id"] in ids]
    if not items:
        await bot.send_message(chat_id, tag("題庫是空的。按 💡 出5題，或 /ideas 10 方向"), reply_markup=MENU)
        return
    for t in items[:20]:
        await bot.send_message(chat_id, f"{who('writer')}\n💡 {t['brief']}", reply_markup=pool_kb(t["id"]))
    rest = len(list_stage("ideas")) - len(items[:20])
    await bot.send_message(chat_id, tag(f"題庫共 {len(list_stage('ideas'))} 題" + (f"（另有 {rest} 題，按 {B_POOL} 看全部）" if rest > 0 else "")
                                         + "。點 ✅ 的才會開寫。"), reply_markup=MENU)


def gaps_markup():
    rows = []
    L, C, J = kinds.KINDS["letter"], kinds.KINDS["chapter"], kinds.KINDS["jh_outline"]
    rows.append([InlineKeyboardButton(f"✉️ {kinds.CHARS[m['character_id']]} {L.TIER[m['at']]}",
                                      callback_data=f"bk:letter:{m['character_id']}:{m['at']}") for m in L.backlog()])
    for m in C.backlog()[:6]:
        rows.append([InlineKeyboardButton(f"📖 {kinds.CHARS[m['character_id']]}第{m['chapter']}章（道緣 {kinds.FAVOR[m['chapter']]}）",
                                          callback_data=f"bk:chapter:{m['character_id']}:{m['chapter']}")])
    jb = J.backlog()[:3]
    g = kinds.gua_data()
    if jb:
        rows.append([InlineKeyboardButton(f"🗺 {m['gua_no']} {g[m['gua_no']-1]['gua']}",
                                          callback_data=f"bk:jh_outline::{m['gua_no']}") for m in jb])
    return InlineKeyboardMarkup([r for r in rows if r])


def gaps_text():
    L, C, J = kinds.KINDS["letter"], kinds.KINDS["chapter"], kinds.KINDS["jh_outline"]
    nl = len(L.POINTS) * 3 - len(kinds.done_slots("letter"))
    return (f"📦 還沒寫的（點一下排進佇列）\n"
            f"✉️ 道緣信：還缺 {nl}/{len(L.POINTS) * 3} 封（只在升階寄：相熟 300／相知 500／知己 800）\n"
            f"📖 道緣章：{len(C.backlog())} 章可寫（前一章有稿才列下一章）\n"
            f"🗺 江湖大綱：還缺 {len(J.backlog())}/63 卦（列最前面 3 卦；指定卦號用 /jianghu 12）")


@admin_only
async def cmd_gaps(update, ctx):
    await update.message.reply_text(tag(gaps_text()), reply_markup=gaps_markup())


async def _cmd_add(update, ctx, kind):
    a = list(ctx.args)
    if kind == "jh_outline":
        if not a:
            return await reply(update, "用法：/jianghu 5　或　/jianghu 5-8")
        m = re.match(r"^(\d+)(?:-(\d+))?$", a[0])
        if not m:
            return await reply(update, "卦號寫 1–64，連排寫 5-8")
        lo, hi = int(m.group(1)), int(m.group(2) or m.group(1))
        out = [await A(ctx).add_task("jh_outline", "", n, " ".join(a[1:])) for n in range(lo, min(hi, lo + 9) + 1)]
        return await reply(update, "\n".join(out))
    if not a:
        return await reply(update, "用法：/letter 師妹 100　/chapter 觀喵 1")
    num = int(a[1]) if len(a) > 1 and a[1].isdigit() else 0
    await reply(update, await A(ctx).add_task(kind, a[0], num, " ".join(a[2:] if num else a[1:])))


@admin_only
async def cmd_letter(update, ctx):
    await _cmd_add(update, ctx, "letter")


@admin_only
async def cmd_chapter(update, ctx):
    await _cmd_add(update, ctx, "chapter")


@admin_only
async def cmd_jianghu(update, ctx):
    await _cmd_add(update, ctx, "jh_outline")


@admin_only
async def cmd_pool(update, ctx):
