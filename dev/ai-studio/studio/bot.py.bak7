                                    reply_markup=InlineKeyboardMarkup(rows))


def jobs_markup():
    rows = []
    for k, j in team.load_jobs().items():
        mark = "🟢" if j["enabled"] else "⚪"
        rows.append([InlineKeyboardButton(f"{mark} {j['name']}", callback_data=f"jb:{k}:{0 if j['enabled'] else 1}")])
    return InlineKeyboardMarkup(rows)


def jobs_text(title="🗓 排程工作（點一下切換開關）"):
    lines = [title]
    for j in team.load_jobs().values():
        lines.append(f"{'🟢' if j['enabled'] else '⚪'} {j['name']}：{j['desc']}")
    return "\n".join(lines)


