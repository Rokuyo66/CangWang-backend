def kb(tid):
    return InlineKeyboardMarkup([[
        InlineKeyboardButton("✅ 通過", callback_data=f"ap:{tid}"),
        InlineKeyboardButton("↩️ 退回", callback_data=f"rd:{tid}"),
        InlineKeyboardButton("🗑 捨棄", callback_data=f"dr:{tid}"),
    ]])


def chunks(text, n=3900):
    while text:
        yield text[:n]
        text = text[n:]


def is_admin(update: Update) -> bool:
    return bool(update.effective_user) and update.effective_user.id == load_config()["admin_id"]


def admin_only(fn):
    async def wrap(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
        if not is_admin(update):
            if update.message:
                await update.message.reply_text(f"未授權。你的 TG ID：{update.effective_user.id}")
            return
        return await fn(update, ctx)
    return wrap


def tag(text, sender="duty"):
    return f"{who(sender)}\n{text}"


async def reply(update, text, sender="duty", **kw):
    kw.setdefault("reply_markup", MENU)
    return await update.message.reply_text(tag(text, sender)[:4000], **kw)


async def notify(app, text, markup=None, sender="duty"):
    try:
        await app.bot.send_message(load_config()["admin_id"], tag(text, sender)[:3900],
                                   reply_markup=markup or MENU)
    except Exception as e:
        log.error("推播失敗：%s", e)


# ---------- 顯卡 ----------
async def gpu_info():
    """回傳 (使用率%, 溫度°C, 功耗上限W)；讀不到回 None。"""
    try:
        samples = []
        for _ in range(3):
            p = await asyncio.create_subprocess_exec(
                "nvidia-smi", "--query-gpu=utilization.gpu,temperature.gpu,power.limit",
                "--format=csv,noheader,nounits",
                stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
            out, _ = await p.communicate()
            u, t, w = [x.strip() for x in out.decode().splitlines()[0].split(",")]
            samples.append((float(u), float(t), float(w)))
            await asyncio.sleep(1)
        return (round(sum(x[0] for x in samples) / 3), max(x[1] for x in samples), samples[-1][2])
    except Exception:
        return None


async def blocked_reason(cfg, st):
    if st["paused"]:
        return f"⏸ 寫稿已暫停（按 {B_RESUME}）"
    if not st["force"] and not in_window(cfg):
        h = cfg["active_hours"]
        return f"💤 不在工作時段 {h[0]}–{h[1]}"
    g = await gpu_info()
    if g:
        util, temp, cap = g
        if util >= cfg["gpu_busy_util"]:
            return f"🎨 顯卡被其他程式佔用（使用率{util}%，多半是 ComfyUI），空出來自動開工"
        if temp >= cfg["gpu_max_temp"]:
            return f"🔥 顯卡過熱 {temp:.0f}°C（上限{cfg['gpu_max_temp']}°C），降溫後自動開工"
    return None


# ---------- 共用動作（按鈕、指令、本地助理共用） ----------
class Actions:
    def __init__(self, app):
        self.app = app

    async def team_status(self):
        o = self.app.bot_data["ollama"]
        try:
            loaded = await o.ps()
        except Exception:
            loaded = []
        return team.roster(loaded, await gpu_info(), self.app.bot_data.get("started_at"),
                           self.app.bot_data.get("agent_busy", False), self.app.bot_data.get("abtest"))

    async def add_task(self, kind, character="", number=0, brief=""):
        k = kinds.KINDS.get(kind)
        if not k:
            return f"不認得的格式：{kind}（letter／chapter／jh_outline）"
        cid = kinds.NAME2ID.get(character, character) if character else ""
        if kind == "letter":
            if cid not in kinds.CHARS:
                return "道緣信要指定角色（大師兄／師妹／觀喵）"
            if not number:
                nxt = [m for m in k.backlog() if m["character_id"] == cid]
                if not nxt:
                    return f"{kinds.CHARS[cid]}的信都排過了"
                number = nxt[0]["at"]
            if int(number) not in k.POINTS:
                return f"道緣點只能是 {k.POINTS}"
            meta = {"character_id": cid, "at": int(number)}
        elif kind == "chapter":
            if cid not in kinds.CHARS or int(number or 0) not in (1, 2, 3, 4):
                return "道緣章要指定角色與第幾章（1–4）"
            meta = {"character_id": cid, "chapter": int(number)}
            if k.slot(meta) in kinds.EXISTING:
                return f"{k.slot(meta)} 已經上線（製作人親寫），不重寫"
        else:
            if not 1 <= int(number or 0) <= 64:
                return "江湖大綱要指定卦號 1–64"
            meta = {"gua_no": int(number)}
        if k.slot(meta) in kinds.done_slots(kind):
            return f"{k.slot(meta)} 已經有稿了（在佇列／待審／已通過）"
        t = new_task(brief or "", source="tg", stage="ideas")  # 先放暫存，欄位齊了才進佇列
        t.update(kind=kind, meta=meta, slot=k.slot(meta))
        t["brief"] = k.label(t) + (f"｜{brief}" if brief else "")
        t["note"] = brief or ""
        move_task(t, "queue")
        st = load_state()
        ahead = len(list_stage("queue")) - 1 + (1 if st.get("current") else 0)
        state = st.get("blocked") or ("寫手忙碌中，排隊" if st.get("current") else "馬上開工")
        return f"已排入：{t['brief']}（#{t['id']}，前面 {ahead} 份）｜{state}"

    async def add_script_task(self, brief):
        t = new_task(brief)
        st = load_state()
        ahead = len(list_stage("queue")) - 1 + (1 if st.get("current") else 0)
        state = st.get("blocked") or ("寫手忙碌中，排隊" if st.get("current") else "馬上開工")
        return f"已加入佇列 #{t['id']}（前面 {ahead} 份）｜{state}"

    async def brainstorm(self, n=5, hint=""):
        n = max(1, min(20, int(n)))
        ideas = await pipeline.brainstorm(self.app.bot_data["ollama"], n, hint or "")
        made = [new_task(x, source="ideas", stage="ideas") for x in ideas]
        self.app.bot_data["last_ideas"] = [t["id"] for t in made]
        return f"已放進題庫 {len(made)} 題，等你挑（按 {B_POOL}）"

    async def list_pending(self):
        items = list_stage("pending")
        if not items:
            return "沒有待審稿。"
        out = []
        for p in items[:15]:
            t = read_json(p)
            s = t["rounds"][-1]["script"] if t.get("rounds") else {}
            rv = t["rounds"][-1]["review"] if t.get("rounds") else {}
            k = kinds.kind_of(t)
            out.append(f"{'⚠️' if t.get('needs_human') else '🟢'}{rv.get('score','?')}分 #{t['id']} "
                       f"{k.label(t) if k else ''} {k.title(s) if k else s.get('title','')}")
        return "\n".join(out)

    async def redo_task(self, task_id, reason=""):
        stage, p = find_task(task_id)
        if not p:
            return f"找不到 {task_id}"
        requeue(read_json(p), reason or None)
        return f"#{task_id} 已退回佇列"

    async def set_writing(self, on):
        save_state(paused=not on)
        st = load_state()
        if not on and st.get("current"):
            return f"⏸ 已暫停：手上 #{st['current']['id']} 跑完就停（要立刻停用 {B_STOP}）"
        return "▶️ 寫稿已恢復" if on else "⏸ 寫稿已暫停"

    async def stop_current(self):
        save_state(paused=True)
        job = self.app.bot_data.get("job")
        if job and not job.done():
            job.cancel()
            return f"⏹ 已中斷，這份放回佇列，寫稿暫停中（{B_RESUME} 繼續）"
        return "目前沒有在跑的稿，已暫停寫稿。"

    async def set_job(self, job, on):
        team.set_job(job, on)
        return f"{team.DEFAULT_JOBS[job]['name']}：{'開啟' if on else '關閉'}"

    async def run_op(self, op):
        return await ops.run_op(self.app, op)

    def handlers(self):
        return {k: getattr(self, k) for k in [
            "team_status", "add_task", "list_pending", "redo_task",
            "set_writing", "stop_current", "set_job", "run_op"]}


def requeue(t, reason=None):
    if reason:
        t.setdefault("human_feedback", []).append(reason)
    t.pop("needs_human", None)
    move_task(t, "queue")


def A(ctx) -> Actions:
    return ctx.application.bot_data["actions"]


